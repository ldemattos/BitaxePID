# Copy to docker/.env and adjust, or export these in your shell before
# `docker compose up`. Only BITAXE_IP is required.

### Build-time (image source) ###
# ALPINE_VERSION=3.20
# BITAXEPID_REPO=https://github.com/ldemattos/BitaxePID.git
# BITAXEPID_REF=main

### Required ###
BITAXE_IP=192.168.68.111

### Pool / stratum (optional) ###
# PRIMARY_STRATUM=stratum+tcp://solo.ckpool.org:3333
# BACKUP_STRATUM=stratum+tcp://public-pool.io:21496
# STRATUM_USER=bc1qexampleaddress.bitaxepid
# FALLBACK_STRATUM_USER=bc1qexampleaddress.bitaxepid
# USER_FILE=user.yaml
# POOLS_FILE=pools.yaml

### Tuning overrides (optional) ###
# VOLTAGE=1200
# FREQUENCY=485
# SAMPLE_INTERVAL=60

### Runtime ###
LOGGING_LEVEL=info
LOG_TO_CONSOLE=true
SERVE_METRICS=false
METRICS_PORT=8093
# DISABLE_FASTEST_POOLS=true skips get_fastest_pools() latency testing at
# startup; requires PRIMARY_STRATUM to be set above. If BACKUP_STRATUM is
# left unset, the primary pool is reused as the backup automatically.
DISABLE_FASTEST_POOLS=false

### Fine-grained ASIC config overrides (uncomment as needed) ###
# BITAXEPID_CFG_TARGET_TEMP=58.0
# BITAXEPID_CFG_HASHRATE_SETPOINT=550
# BITAXEPID_CFG_POWER_LIMIT=16.0
